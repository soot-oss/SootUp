{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplicitPatterns",
  "description": "Pattern for implicit call edges used",
  "type": "object",
  "properties": {
    "implicitPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Unique identifier for the implicit call edge",
            "type": "string"
          },
          "category": {
            "description": "Category identifier for the resolution (e.g., 1 or 2)",
            "type": "integer"
          },
          "caller": {
            "type": "object",
            "properties": {
              "callerFullyQualifiedClassName": {
                "type": "string"
              },
              "callerName": {
                "type": "string"
              },
              "callerParam": {
                "type": "string"
              },
              "callerReturnType": {
                "type": "string"
              }
            },
            "required": [
              "callerFullyQualifiedClassName",
              "callerName",
              "callerParam",
              "callerReturnType"
            ]
          },
          "callee": {
            "type": "object",
            "properties": {
              "calleeFullyQualifiedClassName": {
                "type": "string"
              },
              "calleeName": {
                "type": "string"
              },
              "calleeParam": {
                "type": "string"
              },
              "calleeReturnType": {
                "type": "string"
              }
            },
            "required": [
              "calleeFullyQualifiedClassName",
              "calleeName",
              "calleeParam",
              "calleeReturnType"
            ]
          },
          "resolveCalleeClassName": {
            "description": "Whether the callee class name must be resolved (Required for Category 2)",
            "type": "boolean"
          },
          "interfaceType": {
            "description": "The interface/superClass of the caller (Required for Category 2)",
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "caller",
          "callee"
        ]
      }
    }
  },
  "required": [
    "implicitPatterns"
  ]
}